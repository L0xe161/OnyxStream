# Copy this file to `.env.local` and fill in your own keys.
# Never commit a real .env file. Get your keys from:
#   TMDB:   https://developer.themoviedb.org/docs/authentication
#   SubDL:  https://subdl.com/panel/api
# The app refuses to start the API routes without these — there are no
# hard-coded fallbacks by design.

DATABASE_URL=file:/home/z/my-project/db/custom.db

# TMDB API key — metadata, catalog, search, localized Arabic/English artwork.
TMDB_API_KEY=""

# SubDL API key — Arabic (and other) subtitle discovery and extraction.
SUBDL_API_KEY=""
