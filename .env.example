# Copy this file to `.env.local` and fill in your own TMDB key.
# Never commit a real .env file. Get your key from:
#   TMDB:  https://developer.themoviedb.org/docs/authentication
# There are no hard-coded fallbacks by design; a missing key fails loudly.

DATABASE_URL=file:/home/z/my-project/db/custom.db

# TMDB API key — metadata, catalog, search, localized Arabic/English artwork.
TMDB_API_KEY=""
